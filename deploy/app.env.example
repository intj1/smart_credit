# Non-secret settings and optional integrations for the app container.
# Installed to ~/.config/card-benefits/app.env (chmod 600).
# The database URL, encryption key and first admin password are podman
# secrets, created by deploy/install.sh.

# Login created on the very first start (ignored afterwards).
ADMIN_EMAIL=you@example.com

# Two-factor sign-in (TOTP). Leave on.
REQUIRE_MFA=true
# Set to true once the app is served over HTTPS.
COOKIE_SECURE=false

# Local hours (in the timezone chosen in Settings) for the nightly sync and
# the daily alert email.
SYNC_HOUR=3
ALERT_HOUR=8

# --- Plaid (optional; without it cards are added manually + CSV import) ---
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# sandbox or production
# PLAID_ENV=production
# Needed for OAuth institutions (Capital One, Amex). Must be HTTPS, must be
# registered in the Plaid dashboard, and must point at /oauth-return.
# PLAID_REDIRECT_URI=https://benefits.example.com/oauth-return

# --- Email alerts (optional; without it alerts only show on Home) ---
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Card Benefits <alerts@example.com>
